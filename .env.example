# ══════════════════════════════════════════════════════════════════
#  Variables d'environnement — copiez ce fichier en `.env.local`
#  et renseignez vos valeurs. `.env.local` n'est JAMAIS commité.
#
#  En production, ces mêmes variables se posent chez Hostinger :
#    hostinger hosting nodejs replace-environment-variables <compte> <domaine> \
#      --env-vars '[{"name":"…","value":"…"}]'
#  ⚠️ C'est un REMPLACEMENT INTÉGRAL : toute variable absente de la
#  commande est supprimée. Envoyez toujours le jeu complet.
# ══════════════════════════════════════════════════════════════════
#
# ⚠️ Les clés des passerelles de paiement (Stripe, Fondy, Square…) ne
# sont PAS ici : elles se saisissent dans le back-office, sur
# /admin/payments, et sont stockées en base. Ne les dupliquez pas ici.

# ─── Base de données (MySQL Hostinger) ────────────────────────────
# Créée par `hostinger hosting databases create`. Sans elle, la boutique
# retombe sur un stockage fichier local (dossier ./data) : pratique en
# développement, INUTILISABLE en production — un déploiement remplace le
# contenu du site, donc effacerait les commandes.
#
# Au choix : l'URL complète…
DATABASE_URL=
# …ou les cinq valeurs séparées (l'URL prime si elle est renseignée).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ⚠️ Depuis votre machine, `localhost` ne désigne pas le serveur : il faut
# l'hôte distant ET une connexion autorisée pour votre IP —
#   hostinger hosting databases create-remote-connection <compte> <base> --ip <votre IP>
# À retirer une fois la mise en service terminée. `--ip "%"` ouvre la base
# au monde entier : ne l'utilisez jamais.

# ─── Photos envoyées depuis le back-office ────────────────────────
# ⚠️ DOIT être un dossier HORS de l'arborescence déployée : un
# déploiement remplace tout le contenu du site, et les photos produit
# disparaîtraient. Chez Hostinger : /home/<compte>/media/<prefixe>
# Non renseigné, vaut ./media à la racine du projet (développement).
MEDIA_DIR=

# ─── Back-office ──────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ⚠️ SÉCURITÉ — signe le cookie de session admin.
# Non renseignée en production, une clé ALÉATOIRE est tirée à chaque
# démarrage : personne ne peut forger de cookie, mais vous serez
# déconnecté du back-office à chaque déploiement. Si ça vous arrive,
# c'est que cette variable manque.
# Générez-la avec :  openssl rand -base64 32
AUTH_SECRET=

# ─── Site ─────────────────────────────────────────────────────────
# Sert aux URL absolues (e-mails, retours de paiement). En production,
# le domaine public complet, en https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── E-mails transactionnels (SMTP Hostinger) ─────────────────────
# Boîte créée par `hostinger mail mailboxes create-mailbox <order-id>`.
# Sans ces valeurs, l'envoi est neutralisé proprement (aucune erreur,
# aucun e-mail).
#
# ⚠️ EMAIL_FROM doit porter l'adresse de SMTP_USER : un expéditeur qui
# ne correspond pas à la boîte authentifiée est REFUSÉ par le serveur.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Boutique <commandes@exemple.fr>

# Destinataire des notifications de nouvelle commande.
# ⚠️ Non renseigné, les notifications partent vers brand.contact.email —
# donc au vrai gérant, y compris pendant vos tests. Mettez votre propre
# adresse ici tant que la boutique n'est pas ouverte.
MERCHANT_EMAIL=

# ─── Notification de vente (facultatif) ───────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Référencement ────────────────────────────────────────────────
# "1" tant que les mentions légales ne sont pas celles de l'exploitant
# réel, ou tant que le domaine définitif n'est pas branché.
NOINDEX=
