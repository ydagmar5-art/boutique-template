# ══════════════════════════════════════════════════════════════════
#  Variables d'environnement — copiez ce fichier en `.env.local`
#  et renseignez vos valeurs. `.env.local` n'est JAMAIS commité.
# ══════════════════════════════════════════════════════════════════
#
# ⚠️ Les clés des passerelles de paiement (Stripe, Fondy, Square…) ne
# sont PAS ici : elles se saisissent dans le back-office, sur
# /admin/payments, et sont stockées en base. Ne les dupliquez pas ici.

# ─── Base de données (Supabase) ───────────────────────────────────
# Sans ces trois valeurs, la boutique retombe sur un stockage fichier
# local (dossier ./data) : pratique en développement, inutilisable en
# production — Vercel repart d'un disque vide à chaque déploiement.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Back-office ──────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ⚠️ SÉCURITÉ — signe le cookie de session admin.
# Non renseignée en production, une clé ALÉATOIRE est tirée à chaque
# démarrage : personne ne peut forger de cookie, mais vous serez
# déconnecté du back-office à chaque déploiement. Si ça vous arrive,
# c'est que cette variable manque.
# Générez-la avec :  openssl rand -base64 32
AUTH_SECRET=

# ─── Site ─────────────────────────────────────────────────────────
# Sert aux URL absolues (e-mails, retours de paiement). En production,
# le domaine public complet, en https.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── E-mails transactionnels (Resend) ─────────────────────────────
# Sans RESEND_API_KEY, l'envoi est neutralisé proprement (aucune erreur,
# aucun e-mail). Le domaine de EMAIL_FROM doit être vérifié dans Resend.
RESEND_API_KEY=
EMAIL_FROM=Boutique <commandes@exemple.fr>

# Destinataire des notifications de nouvelle commande.
# ⚠️ Non renseigné, les notifications partent vers brand.contact.email —
# donc au vrai gérant, y compris pendant vos tests. Mettez votre propre
# adresse ici tant que la boutique n'est pas ouverte.
MERCHANT_EMAIL=
